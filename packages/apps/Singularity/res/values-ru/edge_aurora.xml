    <string name="edge_aurora_wake">Фоновая подсветка уведомлений</string>
    <string name="edge_aurora_wake_summary">Ненадолго показывать подсветки на затемнённом экране Always On Display. Если датчик приближения закрыт, экран останется выключенным.</string>
